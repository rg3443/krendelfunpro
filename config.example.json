{
  // Токен от @BotFather
  "telegram_token": "123456789:AA...",
  // Telegram id администраторов (узнать свой: @userinfobot)
  "admin_ids": [111111111],
  "db_path": "rentbot.db",
  "support_contact": "@your_support",

  "pricing": {
    // Тарифы: id уходит серверу ботов в поле "tier", цена — за 1 бота в час
    "tiers": [
      { "id": "smart", "name": "🧠 Умный бот", "description": "Claude Opus: читает чат и отвечает по смыслу", "price_per_bot_hour_rub": 100 },
      { "id": "dumb",  "name": "🤖 Простой бот", "description": "короткие реакции, как обычный зритель", "price_per_bot_hour_rub": 10 }
    ],
    // Возвращать ли деньги, когда заказчик сам отменяет заказ
    "refund_on_cancel": false,
    "min_bots": 1,
    "max_bots": 500,
    "min_hours": 1,
    "max_hours": 72,
    "bot_presets": [5, 10, 25, 50, 100],
    "hour_presets": [1, 2, 3, 6, 12, 24],
    // за сколько минут до окончания заказа предложить продление (0 — не напоминать)
    "remind_before_min": 15
  },

  "payments": {
    // "yookassa" — реальные платежи по СБП; "mock" — тест, платежи подтверждает админ командой /paid <id>
    "provider": "mock",
    "shop_id": "",
    // Прокси только для ЮKassa, если IP сервера она не пускает (пусто — напрямую)
    "proxy": "",
    "secret_key": "",
    // Способы оплаты на выбор клиенту: "sbp" — СБП, "bank_card" — карта. Несколько — бот спросит перед оплатой,
    // один — без вопроса, [] — способ выбирается на странице ЮKassa. В тестовом магазине ЮKassa СБП обычно нет:
    // бот тогда сам предложит карту.
    "payment_methods": ["sbp", "bank_card"],
    // Чеки 54-ФЗ через ЮKassa («Чеки от ЮKassa» или своя касса, подключённая к ЮKassa).
    // Самозанятым обычно не нужно — уточните в ЮKassa. Значения согласуйте с бухгалтером.
    "receipt": {
      "enabled": false,
      "vat_code": 1,                 // 1 — без НДС; 2 — 0%; 3 — 10%; 4 — 20%; ... (коды ставок ЮKassa)
      "item_description": "Пополнение баланса сервиса аренды чат-ботов",
      "payment_subject": "payment",  // предмет расчёта: платёж (пополнение баланса)
      "payment_mode": "advance",     // способ расчёта: аванс (услуга ещё не оказана)
      "tax_system_code": 0           // 1 — ОСН, 2 — УСН доходы, 3 — УСН доходы-расходы, ...; 0 — не передавать
    },
    // Куда вернуть пользователя после оплаты (ссылка на бота)
    "return_url": "https://t.me/your_bot",
    "min_topup_rub": 100,
    "max_topup_rub": 100000,
    "presets_rub": [100, 300, 500, 1000, 3000],
    "poll_interval_sec": 15,
    // сколько минут опрашивать неоплаченный счёт, потом он помечается expired
    "expire_minutes": 1440
  },

  "executor": {
    // "manual" — админ запускает заказы кнопками; "http" — бот сам вызывает сервер ботов (krendelbot)
    "type": "http",
    "url": "http://127.0.0.1:8080/api",
    // тот же секрет, что server.token в config.json krendelbot
    "token": "",
    // сколько минут ждать свободных ботов/успешного запуска, потом отказ с полным возвратом
    "auto_start_timeout_min": 10,
    // как часто спрашивать у сервера состояние запущенных заказов
    "poll_interval_sec": 30,
    // номер заказа на сервере = это число + номер в боте (не пересекается с заказами из консоли сервера).
    // Не меняйте, пока есть активные заказы.
    "order_id_offset": 100000
  }
}
